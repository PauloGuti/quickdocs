      "id": "iniciar-proyecto",
      "name": "Iniciar un proyecto",
      "snippets": [
        {
          "id": "py-venv-crear",
          "title": "Crear entorno virtual",
          "description": "Crea un entorno aislado en la carpeta .venv",
          "language": "bash",
          "code": "python3 -m venv .venv",
          "tags": ["venv", "setup"],
          "variants": {
            "uv": {
              "title": "Iniciar proyecto con uv",
              "description": "Crea pyproject.toml y el entorno .venv juntos",
              "code": "uv init mi_proyecto\ncd mi_proyecto"
            },
            "poetry": {
              "title": "Iniciar proyecto con Poetry",
              "description": "Crea pyproject.toml y gestiona dependencias",
              "code": "poetry init\npoetry install"
            }
          }
        },
        {
          "id": "py-venv-activar",
          "title": "Activar entorno virtual",
          "description": "Activa el entorno en macOS/Linux",
          "language": "bash",
          "code": "source .venv/bin/activate",
          "tags": ["venv", "setup"],
          "variants": {
            "uv": {
              "description": "Con 'uv run' casi nunca hace falta activarlo a mano",
              "code": "source .venv/bin/activate"
            },
            "poetry": {
              "title": "Entrar al entorno de Poetry",
              "code": "poetry shell"
            }
          }
        },
        {
          "id": "py-venv-desactivar",
          "title": "Desactivar entorno virtual",
          "description": "Sale del entorno virtual activo",
          "language": "bash",
          "code": "deactivate",
          "tags": ["venv"],
          "variants": {
            "poetry": {
              "title": "Salir del entorno de Poetry",
              "code": "exit"
            }
          }
        },

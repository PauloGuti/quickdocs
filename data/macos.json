      "snippets": [
        {
          "id": "mac-screencapture",
          "title": "Captura de pantalla",
          "description": "A un archivo, sin usar atajos de teclado",
          "language": "bash",
          "code": "screencapture -x captura.png",
          "tags": ["screenshot"]
        },
        {
          "id": "mac-defaults-hidden-files",
          "title": "Mostrar archivos ocultos en Finder",
          "description": "Alterna con \"NO\" para volver a ocultarlos",
          "language": "bash",
          "code": "defaults write com.apple.finder AppleShowAllFiles YES\nkillall Finder",
          "tags": ["finder", "config"]
        },
        {
          "id": "mac-killall",
          "title": "Reiniciar una app del sistema",
          "description": "Útil tras cambiar preferencias (Finder, Dock, SystemUIServer)",
          "language": "bash",
          "code": "killall Dock",
          "tags": ["procesos"]
        },
        {
          "id": "mac-softwareupdate",
          "title": "Ver actualizaciones de macOS disponibles",
          "description": "Sin instalar nada todavía",
          "language": "bash",
          "code": "softwareupdate --list",
          "tags": ["sistema"]
        },
        {
          "id": "mac-diskutil-list",
          "title": "Listar discos y volúmenes",
          "description": "Igual que Utilidad de Discos, en terminal",
          "language": "bash",

          "tags": ["disco"]
        },
        {
          "id": "mac-caffeinate",
          "title": "Evitar que el Mac se duerma",
          "description": "Útil durante builds o descargas largas",
          "language": "bash",
          "code": "caffeinate -d",
          "tags": ["energía"]
        },
        {

# ─────────────────────────────────────────────────────────────
# QuickDocs — configuración de entorno
# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas tu ".env" real a un repositorio (ver .gitignore).
# ─────────────────────────────────────────────────────────────

# --- General ---
# Nombre visible de la app (por si haces builds propios/whitelabel)
APP_NAME=QuickDocs

# Atajo global para abrir/cerrar el panel. Sintaxis de Electron Accelerator.
# Ejemplos: "CommandOrControl+Shift+9", "CommandOrControl+Space"
GLOBAL_SHORTCUT=CommandOrControl+Shift+9

# Color de acento por defecto: blue | purple | pink | orange | green | graphite
DEFAULT_ACCENT_COLOR=blue

# Tema por defecto: system | light | dark
DEFAULT_THEME=system

# Iniciar automáticamente al encender sesión (true/false)
DEFAULT_START_AT_LOGIN=true

# --- Almacenamiento de documentación ---
# "local"     -> guarda todo en un archivo JSON en el disco del usuario (Fase 1, por defecto)
# "firestore" -> guarda y sincroniza contra Firestore (Fase 2, ver docs/DEPLOY.md)
STORAGE_PROVIDER=local

# --- Firebase / Google Cloud (solo necesario si STORAGE_PROVIDER=firestore) ---
# Estos valores NO son secretos (son la config pública del cliente Firebase),
# la seguridad real la dan las Firestore Security Rules + Google Sign-In.
# Se obtienen en: Firebase Console > Configuración del proyecto > Tus apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Client ID de OAuth 2.0 (tipo "Desktop app") generado en Google Cloud Console
# APIs & Services > Credenciales. Necesario para "Iniciar sesión con Google".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Proyecto de GCP activo (útil al migrar de un proyecto a otro)
GCP_PROJECT_ID=
